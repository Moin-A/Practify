<%= turbo_frame_tag "payment_modal" do %>
  <% if flash[:alert] %>
    <div
      class="
        bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-6
      "
    >
      <%= flash[:alert] %>
    </div>
  <% end %>

  <% if @order && @razorpay_key %>
    <div class="relative w-full">
      <button
        data-action="click->home#togglePaymentModal"
        type="button"
        class="
          absolute top-0 right-2 mt-4 inline-flex items-center justify-center p-2
          text-gray-400 hover:bg-gray-50 hover:text-gray-500 transition-colors
        "
        aria-label="Cancel"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="size-12"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="m9.75 9.75 4.5 4.5m0-4.5-4.5 4.5M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"
          />
        </svg>
      </button>
    </div>
    <div id="modal" class="max-w-md mx-auto mt-16 text-center mb-12">
      <h1 class="text-2xl font-bold mb-2">Complete Payment</h1>
      <p class="text-slate-500 mb-2">Order:
        <code class="text-sm"><%= @order.id %></code></p>
      <p class="text-slate-500 mb-6">Amount:
        <strong>₹<%= number_with_precision(@amount / 100.0, precision: 2) %></strong></p>

      <%= form_with url: verify_calendar_slot_checkout_path(@calendar, @slot), 
                    method: :post, 
                    id: "razorpay-verify-form", 
                    style: "display: none;",
                    data: { turbo: true } do |f| %>
        <%= f.hidden_field :razorpay_order_id %>
        <%= f.hidden_field :razorpay_payment_id %>
        <%= f.hidden_field :razorpay_signature %>
      <% end %>

      <button
        id="pay-btn"
        class="
          px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl
          transition-colors
        "
      >
        Pay ₹<%= number_with_precision(@amount / 100.0, precision: 2) %>
      </button>
    </div>

    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script>
      (function () {
        var btn = document.getElementById("pay-btn");
        var verifyForm = document.getElementById("razorpay-verify-form");

        function openRazorpay() {
          var options = {
            key:      "<%= @razorpay_key %>",
            amount:   "<%= @amount %>",
            currency: "INR",
            name:     "Practify",
            order_id: "<%= @order.id %>",
            prefill: {
              email: "<%= Current.user&.email_address %>"
            },
            handler: function (response) {
              if (verifyForm) {
                document.getElementById("razorpay_order_id").value = response.razorpay_order_id;
                document.getElementById("razorpay_payment_id").value = response.razorpay_payment_id;
                document.getElementById("razorpay_signature").value = response.razorpay_signature;
                verifyForm.requestSubmit();
              }
            },
            modal: {
              ondismiss: function () { console.log("Payment cancelled"); }
            }
          };

          var rzp = new Razorpay(options);
          rzp.on("payment.failed", function (r) {
            alert("Payment failed: " + r.error.description);
          });
          rzp.open();
        }

        if (btn) {
          btn.addEventListener("click", openRazorpay);
        }
        document.addEventListener("turbo:load", function () {
          var b = document.getElementById("pay-btn");
          if (b && !b.dataset.bound) {
            b.dataset.bound = "true";
            b.addEventListener("click", openRazorpay);
          }
        });
      })();
    </script>

  <% else %>
    <div class="max-w-md mx-auto mt-16 text-center text-red-600">
      <p class="font-semibold">Unable to create order.</p>
      <%= link_to "Try again",
      @appointment ? new_appointment_checkout_path(@appointment) : root_path,
      class: "underline" %>
    </div>
  <% end %>
<% end %>
