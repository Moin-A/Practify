<% if flash[:alert] %>
  <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-xl mb-6">
    <%= flash[:alert] %>
  </div>
<% end %>

<% if @order && @razorpay_key %>
  <div class="max-w-md mx-auto mt-16 text-center">
    <h1 class="text-2xl font-bold mb-2">Complete Payment</h1>
    <p class="text-slate-500 mb-2">Order: <code class="text-sm"><%= @order.id %></code></p>
    <p class="text-slate-500 mb-6">Amount: <strong>₹<%= number_with_precision(@amount / 100.0, precision: 2) %></strong></p>

    <button id="pay-btn"
            class="px-8 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">
      Pay ₹<%= number_with_precision(@amount / 100.0, precision: 2) %>
    </button>
  </div>

  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <script>
    (function () {
      var btn = document.getElementById("pay-btn");

      function openRazorpay() {
        var options = {
          key:      "<%= @razorpay_key %>",
          amount:   "<%= @amount %>",
          currency: "INR",
          name:     "Practify",
          order_id: "<%= @order.id %>",
          prefill: {
            email: "<%= Current.user&.email_address %>"
          },
          handler: function (response) {
            // Build hidden form and POST to verify
            var form = document.createElement("form");
            form.method = "POST";
            form.action = "<%= verify_appointment_checkout_path(@appointment) %>";

            var fields = {
              authenticity_token:  document.querySelector('meta[name="csrf-token"]').content,
              razorpay_order_id:   response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature:  response.razorpay_signature
            };

            Object.entries(fields).forEach(function ([name, value]) {
              var input = document.createElement("input");
              input.type  = "hidden";
              input.name  = name;
              input.value = value;
              form.appendChild(input);
            });

            document.body.appendChild(form);
            form.submit();
          },
          modal: {
            ondismiss: function () { console.log("Payment cancelled"); }
          }
        };

        var rzp = new Razorpay(options);
        rzp.on("payment.failed", function (r) {
          alert("Payment failed: " + r.error.description);
        });
        rzp.open();
      }

      // Support both full page load and Turbo navigation
      if (btn) {
        btn.addEventListener("click", openRazorpay);
      }
      document.addEventListener("turbo:load", function () {
        var b = document.getElementById("pay-btn");
        if (b && !b.dataset.bound) {
          b.dataset.bound = "true";
          b.addEventListener("click", openRazorpay);
        }
      });
    })();
  </script>

<% else %>
  <div class="max-w-md mx-auto mt-16 text-center text-red-600">
    <p class="font-semibold">Unable to create order.</p>
    <%= link_to "Try again", @appointment ? new_appointment_checkout_path(@appointment) : root_path, class: "underline" %>
  </div>
<% end %>
