<div class="max-w-4xl mx-auto">
  <h1 class="text-2xl font-semibold text-slate-800 mb-6">Billing & Invoices</h1>

  <% if @invoices.empty? %>
    <div class="bg-white rounded-xl border border-slate-200 p-12 text-center">
      <p class="text-slate-500 text-sm">No invoices yet.</p>
    </div>
  <% else %>
    <div class="bg-white rounded-xl border border-slate-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-slate-100 bg-slate-50">
            <th class="text-left px-6 py-3 font-medium text-slate-500">Date</th>
            <th class="text-left px-6 py-3 font-medium text-slate-500">Package</th>
            <th class="text-left px-6 py-3 font-medium text-slate-500">Sessions</th>
            <th class="text-left px-6 py-3 font-medium text-slate-500">Amount</th>
            <th class="text-left px-6 py-3 font-medium text-slate-500">Order ID</th>
            <th class="text-left px-6 py-3 font-medium text-slate-500">Status</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @invoices.each do |invoice| %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-6 py-4 text-slate-600">
                <%= invoice.created_at.strftime("%d %b %Y") %>
              </td>
              <td class="px-6 py-4 text-slate-800 font-medium capitalize">
                <%= invoice.package %>
              </td>
              <td class="px-6 py-4 text-slate-600">
                <%= invoice.slot_remaining %>
              </td>
              <td class="px-6 py-4 text-slate-800 font-medium">
                ₹<%= invoice.amount %>
              </td>
              <td class="px-6 py-4 text-slate-500 font-mono text-xs">
                <%= invoice.payment_order_id.presence || "—" %>
              </td>
              <td class="px-6 py-4">
                <% if invoice.completed? %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700">
                    Paid
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-amber-50 text-amber-700">
                    Pending
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
