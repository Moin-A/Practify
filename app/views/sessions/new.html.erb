<div
  class="
    flex min-h-screen font-sans antialiased text-[#111] bg-white
    selection:bg-[#26BA9B]/20
  "
  data-controller="tabs"
>

  <div
    class="
      hidden lg:flex flex-col justify-between w-1/2 p-16 bg-[#0B0C0D] text-white
      border-r border-white/5
    "
  >
    <div class="flex items-center gap-2.5 font-semibold text-[15px] tracking-tight">
      <%= image_tag "/icon.png",
      alt: "Practify Logo",
      class: "w-8 h-8 rounded-md shadow-[0_0_15px_rgba(38,186,155,0.3)]" %>
      Practify
    </div>

    <div class="flex-1 flex flex-col justify-center max-w-[520px] mx-auto w-full">
      <h1 class="text-[44px] font-bold leading-[1.1] tracking-[-0.03em] mb-8">
        Your therapy practice,
        <span class="text-[#26BA9B]">simplified.</span>
      </h1>
      <p
        class="
          text-[#888] text-[15px] mb-12 leading-relaxed tracking-tight max-w-md
        "
      >
        Streamline your workflow with intelligent scheduling, secure notes, and
        financial tracking — all in one place.
      </p>

      <div class="space-y-3 w-full">
        <div
          class="
            group flex items-center gap-4 p-5 bg-white/[0.03] border border-white/[0.08]
            rounded-xl hover:bg-white/[0.05] hover:border-white/[0.15] transition-all
            duration-200 w-full
          "
        >
          <div class="text-[#888] group-hover:text-[#26BA9B] transition-colors shrink-0">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><path d="M16 2v4"/><path d="M8 2v4"/><path d="M3 10h18"/></svg>
          </div>
          <div>
            <h3 class="text-[14px] font-semibold tracking-tight text-white">Smart Scheduling</h3>
            <p class="text-[12px] text-[#666]">Manage appointments with a unified system</p>
          </div>
        </div>

        <div
          class="
            group flex items-center gap-4 p-5 bg-white/[0.03] border border-white/[0.08]
            rounded-xl hover:bg-white/[0.05] hover:border-white/[0.15] transition-all
            duration-200 w-full
          "
        >
          <div class="text-[#888] group-hover:text-[#26BA9B] transition-colors shrink-0">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ><path
                d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"
              /><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/></svg>
          </div>
          <div>
            <h3 class="text-[14px] font-semibold tracking-tight text-white">Session Notes</h3>
            <p class="text-[12px] text-[#666]">Encrypted documentation for every session</p>
          </div>
        </div>

        <div
          class="
            group flex items-center gap-4 p-5 bg-white/[0.03] border border-white/[0.08]
            rounded-xl hover:bg-white/[0.05] hover:border-white/[0.15] transition-all
            duration-200 w-full
          "
        >
          <div class="text-[#888] group-hover:text-[#26BA9B] transition-colors shrink-0">
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/></svg>
          </div>
          <div>
            <h3 class="text-[14px] font-semibold tracking-tight text-white">Enterprise Security</h3>
            <p class="text-[12px] text-[#666]">Encrypted at rest and in transit, with role-based permissions</p>
          </div>
        </div>
      </div>
    </div>

    <div class="text-[11px] text-[#444] font-medium tracking-wide uppercase">
      Built for mental health professionals
    </div>
  </div>

  <div
    class="
      flex flex-col justify-center items-center w-full lg:w-1/2 p-8 bg-white
    "
  >
    <div class="w-full max-w-[320px] relative">
      <h2 class="text-[26px] font-bold tracking-[-0.02em] text-[#111] mb-1">Welcome back</h2>
      <p class="text-[#666] text-[13px] mb-8">Sign in to your account to continue</p>

      <div
        class="
          flex p-0.5 bg-[#F5F5F5] rounded-lg mb-6 text-[12px] border border-[#EEE]
        "
      >
        <button
          class="
            flex-1 py-1.5 font-semibold bg-white rounded-md shadow-sm border border-[#EEE]
            text-[#111] cursor-pointer
          "
          data-tabs-target="signIn"
        >Sign In</button>
        <button
          data-tabs-target="signUp"
          class="flex-1 py-1.5 font-semibold text-[#888] cursor-pointer"
        >Sign Up</button>
      </div>

      <%= link_to "/auth/google_oauth2", class: "w-full flex items-center justify-center gap-2.5 py-2.5 border border-[#EEE] rounded-lg hover:bg-[#F9F9F9] transition-all mb-6 no-underline shadow-sm" do %>
        <img
          src="https://www.gstatic.com/images/branding/product/1x/gsa_512dp.png"
          class="w-4 h-4 opacity-90"
          alt="Google"
        >
        <span class="text-[13px] font-semibold text-[#444]">Continue with Google</span>
      <% end %>

      <div class="relative flex py-2 items-center mb-2">
        <div class="flex-grow border-t border-[#F0F0F0]"></div>
        <span class="flex-shrink mx-2 text-[10px] uppercase text-[#AAA] font-bold">Or continue with email</span>
        <div class="flex-grow border-t border-[#F0F0F0]"></div>
      </div>
      <div data-tabs-target="signInForm">
        <%= render "sessions/sign_in" %>
      </div>
      <div data-tabs-target="signUpForm" class="hidden">
        <%= render template: "registrations/new", locals: { user: User.new } %>
      </div>
      <div id="flash" class="absolute bottom-2 left-0 right-0 bottom-[-120px]">
        <%= render "shared/alert" %>
      </div>
    </div>
    <div class="w-full max-w-[320px] mt-6 px-4 py-3 bg-[#F9FAFB] border border-[#EEE] rounded-lg text-center">
      <p class="text-[11px] font-bold text-[#888] uppercase tracking-wider mb-1.5">Demo Credentials</p>
      <p class="text-[12px] text-[#555]">
        <span class="font-semibold text-[#333]">Email:</span> adminuser@user.com
      </p>
      <p class="text-[12px] text-[#555]">
        <span class="font-semibold text-[#333]">Password:</span> test123
      </p>
    </div>
  </div>
</div>
