<%= form_with url: session_path, class: "space-y-5", id: "sign-in-form" do |form| %>
  <div class="space-y-5 h-[260px] m-0">
    <div class="space-y-1.5">
      <%= form.label :email_address,
                 "Email",
                 class:
                   "block text-[11px] font-bold text-[#666] uppercase tracking-wider" %>
      <div class="relative group">
        <div
          class="
            absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-300
            group-focus-within:text-[#26BA9B]
          "
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </div>
        <%= form.email_field :email_address,
                         placeholder: "you@example.com",
                         value: params[:email_address],
                         class:
                           "w-full pl-10 pr-4 py-2.5 bg-[#FAFAFA] border border-[#EEE] rounded-lg text-[13px] focus:bg-white focus:border-[#26BA9B] focus:ring-4 focus:ring-[#26BA9B]/5 outline-none transition-all placeholder:text-[#BBB]" %>
      </div>
    </div>

    <div class="space-y-1.5">
      <div class="flex justify-between items-center">
        <%= form.label :password,
                   "Password",
                   class:
                     "block text-[11px] font-bold text-[#666] uppercase tracking-wider" %>
        <%= link_to "Forgot?",
        new_password_path,
        class: "text-[11px] font-bold text-[#26BA9B] no-underline hover:text-[#1f9b81]" %>
      </div>
      <div class="relative group">
        <div
          class="
            absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-300
            group-focus-within:text-[#26BA9B]
          "
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <%= form.password_field :password,
                            placeholder: "••••••••",
                            class:
                              "w-full pl-10 pr-4 py-2.5 bg-[#FAFAFA] border border-[#EEE] rounded-lg text-[13px] focus:bg-white focus:border-[#26BA9B] focus:ring-4 focus:ring-[#26BA9B]/5 outline-none transition-all placeholder:text-[#BBB]" %>
      </div>
    </div>
  </div>
  <%= form.submit "Sign In",
              class:
                "w-full py-3 m-auto bg-[#111] hover:bg-[#222] text-white font-bold rounded-lg text-[13px] transition-all shadow-md active:scale-[0.99] cursor-pointer" %>
<% end %>
