<div class="flex flex-col justify-center items-center min-h-screen bg-white p-8 font-sans antialiased">
  <div class="w-full max-w-[320px]">
    
    <h2 class="text-[26px] font-bold tracking-[-0.02em] text-[#111] mb-1">Forgot password?</h2>
    <p class="text-[#666] text-[13px] mb-8">Enter your email and we'll send you reset instructions.</p>

    <div id="flash">
      <% if flash[:alert] %>
        <div class="p-3 mb-6 rounded-lg bg-red-50 border border-red-100 text-[12px] text-red-600 font-medium">
          <%= flash[:alert] %>
        </div>
      <% end %>
    </div>

    <%= form_with url: passwords_path, class: "space-y-5" do |form| %>
      
      <div class="space-y-1.5">
        <%= form.label :email_address, "Email Address", class: "block text-[11px] font-bold text-[#666] uppercase tracking-wider" %>
        <div class="relative group">
          <div class="absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-300 group-focus-within:text-brand transition-colors">
             <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </div>
          <%= form.email_field :email_address, 
              required: true, 
              autofocus: true,
              placeholder: "name@company.com", 
              value: params[:email_address],
              class: "w-full pl-10 pr-4 py-2.5 bg-[#FAFAFA] border border-[#EEE] rounded-lg text-[13px] focus:bg-white focus:border-brand focus:ring-4 focus:ring-brand/5 outline-none transition-all placeholder:text-[#BBB]" %>
        </div>
      </div>

      <%= form.submit "Send reset instructions", 
          class: "w-full py-3 bg-[#111] hover:bg-[#222] text-white font-bold rounded-lg text-[13px] transition-all shadow-md active:scale-[0.99] cursor-pointer mt-2" %>
    <% end %>

    <div class="mt-8 pt-6 border-t border-[#F0F0F0] text-center">
      <%= link_to new_session_path, class: "text-[12px] font-semibold text-[#888] hover:text-[#111] transition-colors no-underline inline-flex items-center gap-1.5" do %>
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Back to Sign In
      <% end %>
    </div>

  </div>
</div>