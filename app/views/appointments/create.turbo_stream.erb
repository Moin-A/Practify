<% if @appointment.persisted? %>
  <%= turbo_stream.replace "quick-book-card" do %>
    <div id="quick-book-card" class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100">
      <div class="text-center">
        <div class="w-16 h-16 bg-emerald-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-800 mb-2">Appointment Booked!</h3>
        <p class="text-sm text-slate-500 mb-6">Your appointment has been successfully booked.</p>
        <%= link_to new_checkout_path(appointment_id: @appointment.id, amount: 500), 
            class: "inline-flex items-center gap-2 bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3 px-6 rounded-xl transition-all",
            data: { turbo: false } do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
          </svg>
          Proceed to Payment
        <% end %>
      </div>
    </div>
  <% end %>
<% else %>
  <%= turbo_stream.replace "quick-book-card" do %>
    <div id="quick-book-card" class="bg-white rounded-3xl p-6 shadow-sm border border-red-100">
      <div class="text-center">
        <p class="text-red-600 mb-4">
          <%= @errors&.join(", ") || @appointment&.errors&.full_messages&.join(", ") || "Failed to create appointment" %>
        </p>
        <%= link_to "Try Again", root_path, class: "text-emerald-500 hover:underline" %>
      </div>
    </div>
  <% end %>
<% end %>
