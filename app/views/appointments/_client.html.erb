<div
  class="
    bg-white rounded-xl shadow-sm border border-slate-100 p-6 max-w-2xl mx-auto
  "
>

  <div class="justify-between items-start mb-2">
    <div class="flex flex-col my-4">
      <div class="flex items-center gap-2 mb-4">
        <svg
          class="w-5 h-5 text-emerald-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        <h2 class="text-lg font-bold text-slate-700">Interview Slots</h2>
        <p class="text-xs text-slate-400 font-medium  mt-0.5" id="current_date">
          <% if params[:start_date] %>
            <%= Date.parse(params[:start_date]).strftime("%A, %B %d, %Y") %>
          <% else %>
            <%= Date.current.strftime("%A, %B %d, %Y") %>
          <% end %>
        </div>  
        <%= render "schedules/slot_list", slots: slots, calendar: calendar, date: date, selected_slot_id: selected_slot_id %>
      </p>
      </div>
    </div>
  </div>
