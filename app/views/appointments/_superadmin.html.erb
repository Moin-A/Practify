<div
  class="
    bg-white rounded-xl shadow-sm border border-slate-100 p-6 max-w-2xl mx-auto
  "
>

  <div class="flex justify-between items-start mb-2">
    <div class="flex flex-col">
      <div class="flex items-center gap-2">
        <svg
          class="w-5 h-5 text-emerald-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
          />
        </svg>
        <h2 class="text-xl font-bold text-slate-700">Interview Slots</h2>
      </div>
      <p class="text-xs text-slate-400 font-medium ml-7 mt-0.5" id="current_date">
        <% if params[:start_date] %>
          <%= Date.parse(params[:start_date]).strftime("%A, %B %d, %Y") %>
        <% else %>
          <%= Date.current.strftime("%A, %B %d, %Y") %>
        <% end %>
      </p>
    </div>

    <%= link_to new_calendar_slot_path(calendar, date: params[:start_date]), 
            data: { turbo_frame: "new_slot_form" },
            class: "flex items-center gap-1.5 px-4 py-1.5 bg-emerald-500 text-white text-xs font-bold rounded-lg hover:bg-emerald-600 shadow-sm transition-all" do %>
      <span class="text-lg">+</span>
      Add Slot
    <% end %>
  </div>

  <div id="flash_messages" class="h-12"></div>

  <%= turbo_frame_tag "new_slot_form" %>

  <hr class="border-slate-50 mb-6">

  <%= render "schedules/slot_list", slots: slots, calendar: calendar, date: date, selected_slot_id: selected_slot_id %>
  <%= button_to calendar_release_all_slots_path(calendar, start_date: params[:start_date]), 
    method: :post,
    class: "w-full cursor-pointer mt-4 px-4 py-2.5 bg-emerald-500 my-4 text-white text-sm font-bold rounded-lg hover:bg-emerald-600 mt-8 shadow-sm transition-all flex items-center justify-center gap-2" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
    </svg>
    Release All Slots
  <% end %>
  
  <% if selected_slot_id.present? %>
    <%= button_to calendar_slot_path(calendar, selected_slot_id), 
        method: :delete,
        params: { selected_slot_id: selected_slot_id },
        class: "w-full px-6 py-3 mt-4 bg-red-600 text-white font-semibold text-sm rounded-xl shadow-sm transition-all duration-200 hover:bg-red-700 hover:shadow" do %>
      Delete Slot
    <% end %>
  <% end %>
</div>
