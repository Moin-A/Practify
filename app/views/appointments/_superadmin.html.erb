<div class="bg-white rounded-[1rem] border border-slate-300 shadow-xl shadow-slate-200/40 overflow-hidden max-w-2xl mx-auto">
  
  <div class="p-6 border-b border-slate-200 bg-slate-50/30">
    <div class="flex justify-between items-center">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center shadow-sm">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div>
          <h2 class="text-xl font-bold text-slate-900 tracking-tight">Interview Slots</h2>
          <p class="text-[11px] font-bold text-slate-400 uppercase tracking-widest mt-0.5" id="current_date">
            <% date_val = params[:start_date] ? Date.parse(params[:start_date]) : Date.current %>
            <%= date_val.strftime("%A, %B %d") %>
          </p>
        </div>
      </div>

      <%= link_to new_calendar_slot_path(calendar, date: params[:start_date]), 
              data: { turbo_frame: "new_slot_form" },
              class: "inline-flex items-center gap-2 px-4 py-2 bg-slate-900 text-white text-xs font-bold rounded-xl hover:bg-slate-800 shadow-lg shadow-slate-200 transition-all active:scale-95" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path d="M12 4v16m8-8H4"/></svg>
        Add Slot
      <% end %>
    </div>
  </div>

  <div class="px-6">
    <div id="flash_messages" class="empty:hidden py-4"></div>
    
    <%= turbo_frame_tag "new_slot_form", class: "block transition-all" %>
    
    <div class="py-6">
      <%= render "schedules/slot_list", slots: slots, calendar: calendar, date: date, selected_slot_id: selected_slot_id %>
    </div>
  </div>

  <div class="p-6 bg-slate-50 border-t border-slate-200">
    <div class="flex flex-col sm:flex-row gap-3"> 
      
      <%= button_to calendar_release_all_slots_path(calendar, start_date: params[:start_date]), 
        method: :post,
        form: { class: "flex-1" },
        class: "w-full cursor-pointer px-4 py-3 bg-white border border-slate-300 text-slate-700 text-xs font-bold rounded-xl hover:bg-slate-50 hover:border-slate-400 shadow-sm transition-all flex items-center justify-center gap-2 group" do %>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-slate-400 group-hover:text-emerald-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
        </svg>
        Release All Slots
      <% end %>
      
      <% if selected_slot_id.present? %>
        <%= button_to calendar_slot_path(calendar, selected_slot_id), 
            method: :delete,
            form: { class: "flex-1", data: { turbo_confirm: "Are you sure you want to delete this slot?" } },
            params: { selected_slot_id: selected_slot_id },
            class: "w-full cursor-pointer px-4 py-3 bg-red-50 border border-red-100 text-red-600 text-xs font-bold rounded-xl hover:bg-red-600 hover:text-white shadow-sm transition-all flex items-center justify-center gap-2" do %>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
            <path fill-rule="evenodd" d="M16.5 4.478v.227a48.816 48.816 0 0 1 3.878.512.75.75 0 1 1-.256 1.478l-.209-.035-1.005 13.07a3 3 0 0 1-2.991 2.77H8.084a3 3 0 0 1-2.991-2.77L4.087 6.66l-.209.035a.75.75 0 0 1-.256-1.478A48.567 48.567 0 0 1 7.5 4.705v-.227c0-1.564 1.213-2.9 2.816-2.951a52.662 52.662 0 0 1 3.369 0c1.603.051 2.815 1.387 2.815 2.951Zm-6.136-1.452a51.196 51.196 0 0 1 3.273 0C14.39 3.05 15 3.684 15 4.478v.113a49.488 49.488 0 0 0-6 0v-.113c0-.794.609-1.428 1.364-1.452Zm-.355 5.945a.75.75 0 1 0-1.5.058l.347 9.75.75 1 0 1.499-.058l-.346-9Zm5.48.058a.75.75 0 1 0-1.498-.058l-.347 9a.75.75 0 0 0 1.5.058l.345-9Z" clip-rule="evenodd" />
          </svg>
          Delete Slot
        <% end %>
      <% end %>
    </div>
  </div>
</div>