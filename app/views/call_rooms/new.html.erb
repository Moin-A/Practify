<div class="min-h-screen bg-gray-50 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-6xl mx-auto">

    <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-8">
      <div>
        <h1 class="text-3xl font-extrabold text-gray-900 tracking-tight">Consultation Session</h1>
        <p class="text-gray-500 mt-1">Ready to join your scheduled appointment?</p>
      </div>

      <div
        class="
          mt-4 md:mt-0 flex items-center space-x-2 bg-emerald-100 px-3 py-1 rounded-full
        "
      >
        <span class="relative flex h-3 w-3">
          <span
            class="
              animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400
              opacity-75
            "
          ></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
        </span>
        <span class="text-sm font-medium text-emerald-800">System Ready</span>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

      <div class="lg:col-span-2 space-y-6">
        <div
          class="
            bg-slate-900 rounded-2xl shadow-2xl aspect-video flex flex-col items-center
            justify-center relative overflow-hidden border-4 border-white
          "
        >
          <div
            id="video-call-container"
            class="w-full h-full flex items-center justify-center"
          >
            <div class="text-center p-8">
              <div class="mx-auto h-16 w-16 text-gray-500 mb-4">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"
                  />
                </svg>
              </div>
              <p class="text-gray-400 font-medium text-lg">Your camera will appear here once you start</p>
            </div>
          </div>

          <div
            class="
              absolute bottom-0 inset-x-0 bg-gradient-to-t from-black/80 to-transparent p-6
            "
          >
            <%= form_with model: [@appointment, @call_room], local: true do |f| %>
              <%= turbo_frame_tag "start_session" do %>
                <div class="flex items-center justify-center gap-4">
                  <%= f.submit "Start Session",
                           class:
                             "px-8 py-3 bg-emerald-600 hover:bg-emerald-500 text-white font-bold rounded-full transition-all transform hover:scale-105 shadow-lg flex items-center gap-2",
                           id: "join-call-btn" %>

                  <%= link_to root_path, class: "p-3 bg-white/10 hover:bg-white/20 text-white rounded-full backdrop-blur-md transition-colors", title: "Exit" do %>
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M6 18L18 6M6 6l12 12"
                      />
                    </svg>
                  <% end %>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>

        <div id="flash_messages">
          <%= turbo_frame_tag "flash_messages" %>
        </div>
      </div>

      <div class="space-y-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <h2 class="text-lg font-bold text-gray-900 mb-4 border-b pb-2">Session Info</h2>

          <div class="space-y-4 text-sm">
            <div>
              <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Time Slot</label>
              <p class="text-gray-700 font-medium">
                <%= @appointment.start_at.strftime("%I:%M %p") %>
                -
                <%= @appointment.end_at.strftime("%I:%M %p") %>
              </p>
              <p class="text-gray-500"><%= @appointment.start_at.strftime("%B %d, %Y") %></p>
            </div>

            <% if @appointment.notes.present? %>
              <div>
                <label class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Patient/Client Notes</label>
                <p class="text-gray-600 mt-1 italic">"<%= @appointment.notes %>"</p>
              </div>
            <% end %>

            <div class="pt-4">
              <div class="flex items-center justify-between text-xs text-gray-400 font-mono">
                <span>REF_ID:</span>
                <span>#<%= @appointment.id %></span>
              </div>
            </div>
          </div>
        </div>

        <div class="bg-blue-600 rounded-2xl p-6 text-white shadow-lg shadow-blue-200">
          <h3 class="font-bold flex items-center gap-2 mb-2 text-blue-50">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              /></svg>
            Quick Check
          </h3>
          <ul class="text-sm text-blue-100 space-y-2 list-disc list-inside">
            <li>Ensure your microphone is on</li>
            <li>Check lighting for better video</li>
            <li>Stable internet is recommended</li>
          </ul>
        </div>
      </div>

    </div>
  </div>
</div>
