<%= turbo_frame_tag "slot_credit_package" do %>
 
<div class="col-span-3">
    <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">Payment Required</h2>
    <p class="text-slate-500 mt-1 text-sm my-4">Choose a session package to book this appointment</p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <% current_package = slot.slot_credit&.package %>
    <%# ─── 1 Slot ─── %>
    <div class="<%= current_package == 'starter' ? 'bg-emerald-50 border-2 border-emerald-500' : 'bg-white border-2 border-slate-200 hover:border-emerald-400 hover:shadow-md' %> rounded-2xl p-4 transition-all duration-200 flex h-[280px] flex-col justify-between ">
      <div>
        <p class="text-[10px] font-bold text-emerald-600 uppercase tracking-widest mb-1">Starter</p>
        <h3 class="text-2xl font-extrabold text-slate-900">₹1,500 <span class="text-xs font-normal text-slate-400">/session</span></h3>
        <span class="block mt-2 text-[10px] text-slate-500 leading-snug">Book a single session now.<br>You can always buy more later!</span>
      </div>
        <% if current_package == 'starter' %>
        <%= image_tag "/check.svg", class: "m-auto w-6 h-6 mb-2 text-violet-600 inline" %>
      <% end %>
      <%= link_to current_package == 'starter' ? "Selected" : "Select",
            calendar_slot_credits_path(calendar, slot, slot_credit:{package: "starter"}), method: :post, data: {turbo_method: :post},
            class: "mt-4 block w-full text-center px-1 py-1 text-white text-xs font-bold rounded-xl transition-colors #{current_package == 'starter' ? 'bg-emerald-600 hover:bg-emerald-700' : 'bg-slate-900 hover:bg-slate-800'}" %>
    </div>

    <%# ─── 3 Slots (popular) ─── %>
    <div class="relative <%= current_package == 'standard' ? 'bg-emerald-50 border-2 border-emerald-600 shadow-sm' : 'bg-white border-2 border-emerald-400 hover:border-emerald-500 hover:shadow-md' %> rounded-2xl p-4 transition-all duration-200 flex flex-col justify-between h-[280px]">
      <span class="absolute -top-2.5 left-1/2 -translate-x-1/2 bg-emerald-500 text-white text-[8px] font-bold uppercase tracking-widest px-2.5 py-0.5 rounded-full">Popular</span>
      <div>
        <p class="text-[10px] font-bold text-emerald-600 uppercase tracking-widest mb-1">Standard</p>
        <h3 class="text-2xl font-extrabold text-slate-900">₹3,999 <span class="text-xs font-normal text-slate-400">/ ₹1,333 per session</span></h3>
        <p class="text-slate-400 text-xs mt-1">3 sessions <span class="text-emerald-600 font-semibold">· Save 11%</span></p>
      </div>
      <% if current_package == 'standard' %>
        <%= image_tag "/check.svg", class: "m-auto w-6 h-6 mb-2 text-violet-600 inline" %>
      <% end %>
      <%= link_to current_package == 'standard' ? "Selected" : "Select",
            calendar_slot_credits_path(calendar, slot, slot_credit: {package: "standard"}), method: :post, data: {turbo_method: :post},
            class: "mt-4 block w-full text-center px-1 py-1 text-white text-xs font-bold rounded-xl transition-colors #{current_package == 'standard' ? 'bg-emerald-600 hover:bg-emerald-700' : 'bg-emerald-500 hover:bg-emerald-600'}" %>
    </div>

    <%# ─── 5 Slots ─── %>
    <div class="<%= current_package == 'bundle' ? 'bg-violet-50 border-2 border-violet-500' : 'bg-white border-2 border-slate-200 hover:border-violet-400 hover:shadow-md' %> rounded-2xl p-4 transition-all duration-200 flex flex-col justify-between h-[280px]">
      <div>
        <p class="text-[10px] font-bold text-violet-600 uppercase tracking-widest mb-1">Bundle</p>
        <h3 class="text-2xl font-extrabold text-slate-900">₹5,999 <span class="text-xs font-normal text-slate-400">/ ₹1,199 per session</span></h3>
        <p class="text-slate-400 text-xs mt-1">5 sessions <span class="text-violet-600 font-semibold">· Save 20%</span></p>
      </div>
      <% if current_package == 'bundle' %>
        <%= image_tag "/check.svg", class: "m-auto w-6 h-6 mb-2 text-violet-600 inline" %>
      <% end %>
      <%= link_to current_package == 'bundle' ? "Selected" : "Select",
           calendar_slot_credits_path(calendar, slot, slot_credit: {package: "bundle"}), method: :post, data: {turbo_method: :post},
            class: "mt-4 block w-full text-center px-1 py-1 text-white text-xs font-bold rounded-xl transition-colors #{current_package == 'bundle' ? 'bg-violet-600 hover:bg-violet-700' : 'bg-slate-900 hover:bg-slate-800'}" %>
    </div>

  </div>
</div>
<%end%>
