<%= form_with(model: slot_credit, url: slot_credit.persisted? ? calendar_slot_credit_path(@calendar, @slot, slot_credit) : calendar_slot_credits_path(@calendar, @slot), class: "contents") do |form| %>
  <% if slot_credit.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(slot_credit.errors.count, "error") %> prohibited this slot_credit from being saved:</h2>

      <ul class="list-disc ml-6">
        <% slot_credit.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="my-5">
    <%= form.label :slot_id %>
    <%= form.text_field :slot_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": slot_credit.errors[:slot_id].none?, "border-red-400 focus:outline-red-600": slot_credit.errors[:slot_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :slot_remaining %>
    <%= form.number_field :slot_remaining, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": slot_credit.errors[:slot_remaining].none?, "border-red-400 focus:outline-red-600": slot_credit.errors[:slot_remaining].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :payment_order_id %>
    <%= form.text_field :payment_order_id, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": slot_credit.errors[:payment_order_id].none?, "border-red-400 focus:outline-red-600": slot_credit.errors[:payment_order_id].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :payment_status %>
    <%= form.number_field :payment_status, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": slot_credit.errors[:payment_status].none?, "border-red-400 focus:outline-red-600": slot_credit.errors[:payment_status].any?}] %>
  </div>

  <div class="my-5">
    <%= form.label :amount %>
    <%= form.number_field :amount, class: ["block shadow-sm rounded-md border px-3 py-2 mt-2 w-full", {"border-gray-400 focus:outline-blue-600": slot_credit.errors[:amount].none?, "border-red-400 focus:outline-red-600": slot_credit.errors[:amount].any?}] %>
  </div>

  <div class="inline">
    <%= form.submit class: "w-full sm:w-auto rounded-md px-3.5 py-2.5 bg-blue-600 hover:bg-blue-500 text-white inline-block font-medium cursor-pointer" %>
  </div>
<% end %>
