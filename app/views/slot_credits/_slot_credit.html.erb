<div id="<%= dom_id slot_credit %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Slot:</strong>
    <%= slot_credit.slot_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Package:</strong>
    <%= slot_credit.package %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Slot remaining:</strong>
    <%= slot_credit.slot_remaining %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Payment order:</strong>
    <%= slot_credit.payment_order_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Payment status:</strong>
    <%= slot_credit.payment_status %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Amount:</strong>
    <%= slot_credit.amount %>
  </div>
</div>
