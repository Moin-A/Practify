<% content_for :title, "Editing slot credit" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Editing slot credit</h1>

  <%= render "form", slot_credit: @slot_credit %>

  <%= link_to "Show this slot credit", calendar_slot_credit_path(@calendar, @slot, @slot_credit), class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
  <%= link_to "Back to slot credits", calendar_slot_credits_path(@calendar, @slot), class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>
</div>
