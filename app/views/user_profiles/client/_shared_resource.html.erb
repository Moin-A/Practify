<div 
  data-action="click->user-profile#toggleSharedResource"
  data-user-profile-type-param="sharedResource"
  data-user-profile-target="sharedResource"
  class="bg-white rounded-[2rem] border border-slate-100 p-8 shadow-sm cursor-pointer transition-colors overflow-hidden hover:border-slate-200"
> 
  <div class="flex justify-between items-center">
    <div>
      <h3 id="shared-resources-title" class="text-xl font-bold text-slate-900">Shared Resources</h3>
      <p class="text-xs text-slate-400 my-3 py-2">Materials and insights shared for the client journey</p>
    </div>
    <div class="relative" data-action="click->user-profile#toggleDropdown:stop">
      <button type="button" class="p-2 hover:bg-slate-50 rounded-full transition-colors">
        <svg data-user-profile-target="chevron" class="w-5 h-5 text-slate-400 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
    </div>
  </div>

  <%# Collapsible wrapper %>
  <div data-user-profile-target="sharedResourceContent" 
       class="overflow-hidden transition-[max-height] duration-500 ease-in-out"
       style="max-height: 0">

    <div class="max-h-screen transition-all duration-300 ease-in-out">
      <% if can?(:create, ClientResource) %>
        <div id="new_resource_form" class="mb-8">
          <%= render 'client_resources/form', 
                    client_resource: client.user.shared_resources.new, 
                    notable: client.user, 
                    frame_id: "new_resource_form",
                    show_cancel: false %>
        </div>
      <% end %>

      <div id="shared_resources_list" class="space-y-6 relative">
        <% client.user.shared_resources.reload.order(created_at: :desc).each do |resource| %>  
          <%= render 'client_resources/client_resource', client_resource: resource %>
        <% end %>
      </div>
    </div>
  </div>        
</div>
