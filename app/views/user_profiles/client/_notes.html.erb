<div 
  data-action="click->user-profile#toggleNotes"
  data-user-profile-type-param="notes"
  data-user-profile-target="notes"

  class="bg-white rounded-[2rem] border border-slate-100 p-8 shadow-sm cursor-pointer transition-colors overflow-hidden hover:border-slate-200"
> 
  <div class="flex justify-between items-center">
    <div>
      <h3 id="private-notes-title" class="text-xl font-bold text-slate-900">Private Client Notes</h3>
      <p class="text-xs text-slate-400 my-3 py-2">Only visible to clinical staff</p>
    </div>
    <div class="relative" data-action="click->user-profile#toggleDropdown:stop">
      <button type="button" class="p-2 hover:bg-slate-50 rounded-full transition-colors">
        <%# chevron icon — rotates when open %>
        <svg data-user-profile-target="chevron" class="w-5 h-5 text-slate-400 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
        </svg>
      </button>
      <div data-user-profile-target="dropdown" class="absolute right-0 mt-2 w-48 bg-white border border-slate-100 rounded-xl shadow-xl z-50 py-2 hidden opacity-0 origin-top-right transition-all duration-150">
        <button class="w-full text-left px-4 py-2 text-sm text-slate-600 hover:bg-slate-50 transition-colors">Download PDF</button>
      </div>
    </div>
  </div>

  <%# Collapsible wrapper %>
<div data-user-profile-target="notesContent" 
     class="overflow-hidden transition-[max-height] duration-500 ease-in-out"
     style="max-height: 0">

    <div 
      class="max-h-screen transition-all duration-300 ease-in-out"
    >
      <div id="new_note_form">
        <%= render 'notes/form', 
                  note: client.user.private_client_notes.new, 
                  notable: client.user, 
                  category: 'note', 
                  frame_id: "new_note_form",
                  show_cancel: false %>
      </div>

      <div id="private_client_notes_list" class="space-y-6 relative before:bg-slate-100">
        <% client.user.private_client_notes.reload.each do |note| %>  
          <%= render 'notes/note', note: note %>
        <% end %>
      </div>
    </div>
  </div>        
</div>