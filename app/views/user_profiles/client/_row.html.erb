    <tr class="group hover:bg-green-50/30 transition-colors">
        <td class="px-6 py-5 whitespace-nowrap">
            <div class="flex items-center gap-4">
                <div class="relative">
                    <div class="w-11 h-11 rounded-xl  bg-green-500 text-white flex items-center justify-center font-bold text-sm shadow-md shadow-green-100">
                        <%= user.full_name.first(2).upcase %>
                    </div>                  
                </div>
                <div>
                    <p class="font-semibold text-slate-900 group-hover:text-green-600 transition-colors">
                        <%= user.full_name %>
                    </p>
                    <p class="text-xs text-slate-400 font-medium">abc@example.com</p>
                </div>
            </div>
        </td>

        <td class="px-6 py-5 whitespace-nowrap">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                Active
            </span>
        </td>

        <td class="px-6 py-5 whitespace-nowrap">
            <div class="text-sm text-slate-600 font-medium">Oct 12, 2023</div>
            <div class="text-[11px] text-slate-400">14:30 PM</div>
        </td>

        <td class="px-6 py-5 whitespace-nowrap text-right">
            <div class="flex justify-end gap-2">
                <%= link_to "Profile", user_profile_path(user), class: "px-3 py-1.5 text-xs font-bold text-green-600 bg-green-50 rounded-lg hover:bg-green-100 transition" %>
                <button class="p-1.5 text-slate-400 hover:text-slate-600 hover:bg-slate-100 rounded-lg transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"></path>
                    </svg>
                </button>
