<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Practify" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
  <% if authenticated? %>
    <div class="flex flex-col md:flex-row min-h-screen bg-slate-50 font-sans text-slate-900">
      <%= render NavComponent.new(current_user: current_user) %>
      <%= turbo_stream_from current_user %>
      
      <main class="flex-1 mt-16 md:mt-0 md:ml-64 p-4 md:p-8 overflow-y-auto w-full">
        <div class="max-w-7xl mx-auto">
          <%= yield %>
        </div>
      </main>
    </div>
  <% else %>
    <main><%= yield %></main>
  <% end %>
</body>
</html>
