<%= turbo_frame_tag local_assigns[:frame_id] || "modal" do %>
  <% client_resource = local_assigns[:client_resource] || @note || @client_resource %>
  <% notable = local_assigns[:notable] || @notable %>

  <div class="mb-10 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm" data-controller="trix-image-resize">
    <%= form_with(
          model: [notable, client_resource],
          url: client_resource.new_record? ? user_shared_resources_path(notable) : user_shared_resource_path(notable, client_resource),
          class: "w-full"
        ) do |form| %>

      <%# Errors %>
      <% if client_resource.errors.any? %>
        <div class="bg-red-50 text-red-700 p-4 rounded-md mb-4">
          <h2 class="font-medium">
            <%= pluralize(client_resource.errors.count, "error") %>
            prohibited this resource from being saved:
          </h2>
          <ul class="list-disc list-inside mt-2">
            <% client_resource.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# Title field %>
      <div class="mb-6">
        <%= form.label :body,
                   "Resource Title",
                   class:
                     "block text-sm font-bold text-slate-800 mb-2 uppercase tracking-tight" %>
        <%= form.text_field :body,
                        class:
                          "w-full bg-slate-50 border border-slate-200 rounded-2xl focus:ring-emerald-500 focus:border-emerald-500 text-sm py-3 px-4 transition-all hover:bg-white",
                        placeholder: "e.g., Managing Stress in Daily Life" %>
      </div>

      <%# Rich text editor %>
      <div class="mb-6">
        <%= form.label :content,
                   "Detailed Content & Media",
                   class:
                     "block text-sm font-bold text-slate-800 mb-2 uppercase tracking-tight" %>

        <div
          class="
            trix-wrapper rounded-2xl border border-slate-200 shadow-inner
            bg-slate-50 focus-within:ring-2 focus-within:ring-emerald-500
            focus-within:border-emerald-500
          "
        >
          <%= form.rich_text_area :content, class: "min-h-[150px] trix-content" %>
        </div>

        <p class="mt-2 text-[10px] text-slate-400 font-medium italic">
          Tip: You can drag and drop images or paste them directly into the
          editor. Use the toolbar for formatting, links, and attachments.
        </p>
      </div>

      <%# Actions %>
      <div class="flex justify-end mt-6 gap-3">
        <% if local_assigns.fetch(:show_cancel, false) %>
          <%= link_to "Cancel",
                new_user_shared_resource_path(notable),
                data: { turbo_frame: "new_resource_form" },
                class: "px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50" %>
        <% end %>
        <%= form.submit "Save Resource",
                    class:
                      "bg-emerald-600 text-white px-6 py-2 rounded-xl text-sm font-bold hover:bg-emerald-700 transition-colors cursor-pointer shadow-sm" %>
      </div>
    <% end %>
  </div>
<% end %>
