<% is_booked = appointment_created?(slot[:id]) %>
<% is_selected = slot_selected?(slot[:id], selected_slot_id) %>
<%= link_to calendar_schedule_path(calendar, { selected_slot_id: slot[:id], start_date: date }), 
    data: { turbo_frame: "interview_slots" },
    class: "relative py-3 px-3 bg-white border rounded-lg text-center font-semibold text-sm shadow-sm transition-all duration-200 block #{is_booked ? 'bg-emerald-600 border-emerald-600 text-white' : is_selected ? 'bg-emerald-600 border-emerald-600 text-white' : 'border-gray-200 text-gray-700 hover:border-emerald-300 hover:shadow'}" do %>
  
  <% if is_booked %>
    <% if current_user.super_admin? || appointment_created_by_current_user?(slot[:id]) %>
      <div class="absolute top-[-6px] right-[-6px] flex flex-col items-end gap-0.5">                   
        <span class="text-[10px] font-medium text-emerald-600 bg-white px-1.5 py-0.5 rounded border-emerald-200 whitespace-nowrap">
          <%=slot.appointment.status.titleize %>
        </span>
      </div>   
        <span class="relative text-[#666] z-[1]"><%= slot.start_at.strftime("%I:%M %p") %></span>
    <% else %>
      <div class="absolute text-[10px] top-[-6px] right-[-6px] bg-white rounded-full px-1.5 py-0.5 flex items-center justify-center rounded-sm text-orange-600 border-orange-200">
        unavailable
      </div>
          <span class="relative text-[#666] z-[1]"><%= slot.start_at.strftime("%I:%M %p") %></span>
    <% end %>                    
  <% else %>
    
    <span class="relative text-[#666] z-[1]"><%= slot.start_at.strftime("%I:%M %p") %></span>
  <% end %>  
<% end %>
