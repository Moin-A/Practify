<div id="<%= slot_id(slot) %>" class="flex items-center justify-between p-4 bg-white border border-slate-100 rounded-xl hover:shadow-md transition-shadow duration-200">
  <div class="flex items-center gap-4">
    <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
    </svg>
    <span class="text-sm font-bold text-slate-600">
      <%= slot.start_at.strftime("%I:%M %p") %> - <%= slot.end_at.strftime("%I:%M %p") %>
    </span>
    <span class="px-2.5 py-0.5 <%= slot.available? ? 'bg-emerald-50 text-emerald-600 border-emerald-100' : 'bg-orange-50 text-orange-500 border-orange-100' %> text-[8px] font-bold rounded-sm border capitalize px-2 tracking-tight">
      <%= slot.status %>
    </span>
  </div>
  <div class="flex items-center gap-2">
    <% if slot.available? %>
      <%= button_to "Book", appointments_path(slot_id: slot.id),
          method: :post,
          class: "px-3 py-1 bg-blue-500 text-white text-xs font-bold rounded hover:bg-blue-600 transition-colors" %>
    <% end %>
    <%= button_to calendar_slot_path(slot.calendar, slot),
        method: :delete,
        data: { confirm: "Are you sure you want to delete this slot?" },
        class: "text-slate-300 hover:text-red-500 transition-colors" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
      </svg>
    <% end %>
  </div>
</div>