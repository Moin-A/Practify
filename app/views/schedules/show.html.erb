<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>

<div class="max-w-7xl mx-auto" data-controller="home">
  <h1 class="text-2xl font-bold text-slate-800 mb-12">Schedule</h1>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <%# Calendar Section %>
    <div class="lg:col-span-2 space-y-6">
      <%= month_calendar(events: @meetings) do |date, meetings| %>
        <%= date %>
      <% end %>
      <div id="flash_messages" class="mb-6">
        <%= turbo_frame_tag "flash_messages" %>
      </div>
    </div>

    <%# Appointments Section %>

    <div class="w-full max-w-none mx-0 gap-6">
      <%= render template: "appointments/show",
      locals: {
        date: @date,
        slots: @slots,
        calendar: @calendar,
        selected_slot_id: @selected_slot_id,
      } %>
    </div> 
  </div> 

  <%= render partial: "checkouts/confirm_payment_modal" %>
</div>
