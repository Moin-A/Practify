<div
  data-home-target="modal"
  class="
    fixed z-50 inset-0 flex items-center justify-center bg-slate-900/50
    backdrop-blur-sm hidden
  "
  aria-labelledby="modal-title"
  role="dialog"
  aria-modal="true"
>
  <div
    class="
      relative transform overflow-hidden rounded-xl bg-white text-left shadow-2xl
      transition-all sm:my-8 sm:w-full sm:max-w-md
    "
  >
    <%= turbo_frame_tag "reschedule_calendar" do %>
      <div class="bg-white px-4 pt-5 pb-2 sm:px-6">
        <h3 class="text-base font-semibold leading-6 text-gray-900" id="modal-title">Select a Date</h3>
      </div>

      <%= render "calendars/reschedule_calendar_content",
      calendar: calendar,
      start_date: start_date,
      date_range: date_range,
      passed_block: passed_block %>
    <% end %>
  </div>
</div>
