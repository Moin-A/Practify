<% user ||= User.new %>
<%= form_with model: user, url: registration_path, data: { tabs_target: "signUpForm" } do |form| %>

  <div class="space-y-5 h-[260px] m-0">

    <div class="space-y-1.5">
      <%= form.label :email_address,
                 "Work Email",
                 class:
                   "block text-[11px] font-bold text-[#666] uppercase tracking-wider" %>
      <div class="relative group">
        <div
          class="
            absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-300
            group-focus-within:text-brand transition-colors
          "
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        </div>
        <%= form.email_field :email_address,
                         required: true,
                         placeholder: "name@company.com",
                         class:
                           "w-full pl-10 pr-4 py-2.5 bg-input-bg border border-input-border rounded-lg text-[13px] focus:bg-white focus:border-brand focus:ring-4 focus:ring-brand/5 outline-none transition-all placeholder:text-[#BBB]" %>
      </div>
    </div>

    <div class="space-y-1.5">
      <%= form.label :password,
                 "Password",
                 class:
                   "block text-[11px] font-bold text-[#666] uppercase tracking-wider" %>
      <div class="relative group">
        <div
          class="
            absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-300
            group-focus-within:text-brand transition-colors
          "
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
        </div>
        <%= form.password_field :password,
                            required: true,
                            placeholder: "At least 8 characters",
                            class:
                              "w-full pl-10 pr-4 py-2.5 bg-input-bg border border-input-border rounded-lg text-[13px] focus:bg-white focus:border-brand focus:ring-4 focus:ring-brand/5 outline-none transition-all placeholder:text-[#BBB]" %>
      </div>
    </div>

    <div class="space-y-1.5">
      <%= form.label :password_confirmation,
                 "Confirm Password",
                 class:
                   "block text-[11px] font-bold text-[#666] uppercase tracking-wider" %>
      <div class="relative group">
        <div
          class="
            absolute inset-y-0 left-0 flex items-center pl-3.5 text-slate-300
            group-focus-within:text-brand transition-colors
          "
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          ><path d="M20 6 9 17l-5-5"/></svg>
        </div>
        <%= form.password_field :password_confirmation,
                            required: true,
                            placeholder: "Repeat password",
                            class:
                              "w-full pl-10 pr-4 py-2.5 bg-input-bg border border-input-border rounded-lg text-[13px] focus:bg-white focus:border-brand focus:ring-4 focus:ring-brand/5 outline-none transition-all placeholder:text-[#BBB]" %>
      </div>
    </div>

  </div>

  <%= form.submit "Create Account",
              class:
                "w-full m-auto py-3 bg-[#111] hover:bg-[#222] text-white font-bold rounded-lg text-[13px] transition-all shadow-md active:scale-[0.99] cursor-pointer" %>
<% end %>
