<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <div class="flex items-center gap-4">
      <%= link_to "← Back to #{@category == 'note' ? 'Private Client Notes' : 'Therapist Observations'}",
          @category == 'note' ? user_private_client_notes_path(@notable) : user_therapist_observations_path(@notable),
          class: "text-sm text-gray-600 hover:text-gray-900 transition-colors" %>
    </div>
    <div class="flex items-center gap-2">
      <%= link_to "Edit",
          @category == 'note' ? edit_user_private_client_note_path(@notable, @note) : edit_user_therapist_observation_path(@notable, @note),
          class: "inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500",
          data: { turbo_frame: "modal" } %>
      <%= button_to "Delete",
          @category == 'note' ? user_private_client_note_path(@notable, @note) : user_therapist_observation_path(@notable, @note),
          method: :delete,
          data: { confirm: 'Are you sure?', turbo_frame: "modal" },
          class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
    </div>
  </div>

  <div class="max-w-3xl mx-auto">
    <article class="bg-white rounded-2xl border border-slate-200 shadow-sm p-8">
      <header class="mb-6 pb-6 border-b border-slate-200">
        <div class="flex items-center justify-between">
          <div class="flex flex-col gap-2">
            <h1 class="text-2xl font-bold text-gray-900">
              <%= @category == 'note' ? 'Private Client Note' : 'Therapist Observation' %>
            </h1>
            <div class="flex items-center gap-4 text-sm text-gray-500">
              <time class="font-medium">
                Created <%= @note.created_at.strftime("%B %-d, %Y at %-I:%M %p") %>
              </time>
              <% if @note.updated_at != @note.created_at %>
                <time class="font-medium">
                  Updated <%= time_ago_in_words(@note.updated_at) %> ago
                </time>
              <% end %>
            </div>
          </div>
        </div>
      </header>

      <div class="prose prose-slate max-w-none">
        <div class="text-base text-slate-700 leading-relaxed whitespace-pre-wrap">
          <%= @note.body %>
        </div>
      </div>
    </article>
  </div>
</div>

<%= turbo_frame_tag "modal" %>
