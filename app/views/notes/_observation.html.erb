<article id="<%= dom_id(observation) %>" class="relative pl-12 group before:absolute before:content-[''] before:left-4 before:top-3 before:bottom-[35%] hover:before:border-slate-300 before:w-8 before:border-b before:border-slate-100 last:before:bottom-4">
  <div class="absolute left-0 top-1 w-8 h-8  rounded-full bg-white border-4 border-emerald-100 group-hover:border-emerald-500 transition-colors z-10"></div>
  <header class="flex items-center gap-2 mb-2">
    <span class="text-sm font-bold text-slate-900">Dr. Sarah Johnson</span>
    <time class="text-[10px] font-bold text-slate-400 uppercase"><%= observation.created_at.strftime("%b %-d, %Y") %></time>
  </header>
  <div class="p-5 bg-slate-50/50 rounded-2xl border border-slate-100 group-hover:bg-white group-hover:shadow-md transition-all">
    <p class="text-sm text-slate-600 leading-relaxed"><%= observation.body %></p>
  </div>
</article>