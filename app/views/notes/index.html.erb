<%= turbo_frame_tag "modal" %>
<div class="container mx-auto px-4 py-8">
  <div class="flex justify-between items-center mb-6">
    <h1 class="text-2xl font-bold text-gray-900">
      <%= @category == 'note' ? 'Private Client Notes' : 'Therapist Observations' %>
    </h1>
    <%= link_to "New Note",
        @category == 'note' ? new_user_private_client_note_path(@notable) : new_user_therapist_observation_path(@notable),
        class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500",
        data: { turbo_frame: "modal" } %>
  </div>

  <div id="notes" class="space-y-4">
    <%= render @notes %>
    <% if @notes.empty? %>
      <div class="text-center py-12 bg-gray-50 rounded-lg border-2 border-dashed border-gray-300">
        <p class="text-gray-500">No notes found.</p>
      </div>
    <% end %>
  </div>
</div>
