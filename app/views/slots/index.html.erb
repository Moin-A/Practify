<div class="max-w-7xl mx-auto py-8 px-4">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-2xl font-bold text-slate-800">Slots</h1>
    <%= link_to new_calendar_slot_path(@calendar), 
        class: "flex items-center gap-1.5 px-4 py-1.5 bg-emerald-500 text-white text-xs font-bold rounded-lg hover:bg-emerald-600 shadow-sm transition-all" do %>
      <span class="text-lg">+</span> Add Slot
    <% end %>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-slate-100 p-6">
    <% if @slots.any? %>
      <div class="space-y-4">
        <% @slots.each do |slot| %>
          <div class="flex items-center justify-between p-4 bg-white border border-slate-100 rounded-xl hover:shadow-md transition-shadow duration-200">
            <div class="flex items-center gap-4">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <div>
                <p class="text-sm font-bold text-slate-700">
                  <%= slot.start_at.strftime("%B %d, %Y at %I:%M %p") %> - 
                  <%= slot.end_at.strftime("%I:%M %p") %>
                </p>
                <p class="text-xs text-slate-400">
                  Duration: <%= ((slot.end_at - slot.start_at) / 1.hour).round(2) %> hours
                </p>
              </div>
              <span class="px-2.5 py-0.5 <%= slot.available? ? 'bg-emerald-50 text-emerald-600 border-emerald-100' : 'bg-orange-50 text-orange-500 border-orange-100' %> text-[8px] font-bold rounded-sm border capitalize tracking-tight">
                <%= slot.status %>
              </span>
            </div>
            <div class="flex items-center gap-2">
              <%= link_to calendar_slot_path(@calendar, slot), 
                  class: "text-slate-400 hover:text-emerald-500 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              <% end %>
              <%= link_to edit_calendar_slot_path(@calendar, slot), 
                  class: "text-slate-400 hover:text-blue-500 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
              <% end %>
              <%= link_to calendar_slot_path(@calendar, slot), method: :delete, 
                  data: { confirm: "Are you sure?" },
                  class: "text-slate-300 hover:text-red-500 transition-colors" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-12">
        <p class="text-slate-400 mb-4">No slots found.</p>
        <%= link_to "Create your first slot", new_calendar_slot_path(@calendar), 
            class: "inline-flex items-center gap-1.5 px-4 py-1.5 bg-emerald-500 text-white text-xs font-bold rounded-lg hover:bg-emerald-600 shadow-sm transition-all" %>
      </div>
    <% end %>
  </div>
</div>
