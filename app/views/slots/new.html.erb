<%= turbo_frame_tag "new_slot_form" do %>
  <div class="max-w-2xl mx-auto py-8 " data-controller="slot-form">
    <%= form_with model: [@calendar, @slot], class: "space-y-5" do |form| %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <%= form.label :start_at,
                     "Start At",
                     class: "block text-sm font-medium text-gray-700 py-4" %>
          <%= form.datetime_field :start_at,
                              value:
                                (
                                  if params[:date].present?
                                    Date.parse(params[:date]).strftime("%Y-%m-%dT09:00")
                                  else
                                    nil
                                  end
                                ),
                              class:
                                "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                              data: {
                                slot_form_target: "startAt",
                                action: "slot-form#updateEndTime",
                              } %>
        </div>
        <div>
          <%= form.label :end_at,
                     "End At",
                     class: "block text-sm font-medium text-gray-700 py-4" %>
          <%= form.datetime_field :end_at,
                              value:
                                (
                                  if params[:date].present?
                                    Date.parse(params[:date]).strftime("%Y-%m-%dT10:00")
                                  else
                                    nil
                                  end
                                ),
                              class:
                                "w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500",
                              data: {
                                slot_form_target: "endAt",
                              } %>
        </div>
      </div>
      <div class="flex flex-row items-center gap-2 pt-4">
        <%= form.submit "Create Slot",
                    class:
                      "px-4 py-1.5 bg-emerald-500 text-white text-xs font-bold rounded-lg hover:bg-emerald-600 shadow-sm transition-all cursor-pointer" %>
        <%= link_to "Cancel",
        "#",
        onclick: "this.closest('turbo-frame').innerHTML = ''; return false;",
        class:
          "px-4 py-1.5 bg-slate-100 text-slate-700 text-xs font-bold rounded-lg hover:bg-slate-200 transition-all" %>
      </div>
    <% end %>
  </div>
<% end %>
