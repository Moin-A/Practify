<div class="flex-1 overflow-y-auto max-w-7xl mx-auto" data-controller="client-component">
  <%= render HeaderComponent.new(title: title, subtitle: @subtitle) %>
   <div class="flex-1 overflow-auto bg-slate-50/50">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    
    <%# --- Left Column (Main Content) --- %>
    <div class="lg:col-span-2 space-y-6">
      
      <%# Next Appointment Card %>
      <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100 border-l-4 border-l-emerald-500">
        <div class="flex justify-between items-start mb-6">
          <h3 class="text-lg font-bold text-slate-800">Next Appointment</h3>
          <span class="px-3 py-1 bg-emerald-50 text-emerald-600 rounded-full text-xs font-bold flex items-center gap-1">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            Video Call
          </span>
        </div>
        
        <div class="flex items-center gap-4 mb-8">
          <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center font-bold text-sm">DSS</div>
          <div>
            <p class="font-bold text-slate-800">Dr. Sarah Smith</p>
            <p class="text-xs text-slate-400">Licensed Therapist</p>
          </div>
          <div class="ml-auto flex gap-6 text-sm text-slate-500">
            <span class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg> Friday, Jan 10</span>
            <span class="flex items-center gap-2"><svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> 10:00 AM</span>
          </div>
        </div>

        <div class="flex gap-3">
          <button class="flex-1 bg-emerald-500 hover:bg-emerald-600 text-white font-bold py-3 rounded-xl transition-all">Join Session</button>
          <button class="px-6 py-3 border border-slate-200 text-slate-600 font-bold rounded-xl hover:bg-slate-50 transition-all">Reschedule</button>
        </div>
      </div>

      <%# Quick Book Card %>
      <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100">
        <div class="flex justify-between items-center mb-6">
          <h3 class="flex items-center gap-2 text-lg font-bold text-slate-800">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><path d="M16 2v4M8 2v4M3 10h18M10 14h4M12 12v4"/></svg>
            Quick Book
          </h3>
          <a href="#" class="text-emerald-500 text-xs font-bold flex items-center gap-1 hover:underline">Full Calendar <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path d="M9 5l7 7-7 7"/></svg></a>
        </div>
        <p class="text-xs text-slate-400 mb-4">Available slots for Tomorrow</p>
        <%= helpers.turbo_frame_tag "quick_book" do %>
          <div class="grid grid-cols-3 gap-3 mb-4">                  
            <% if next_day_available_slots.empty? %>
              <p class="text-center text-lg flex text-slate-400 font-medium col-span-3 mx-auto">No slots available for tomorrow</p>
            <% else %>
              <% next_day_available_slots.each do |slot| %>                
                <%= helpers.link_to helpers.root_path(selected_slot_id: slot[:id]), 
                    data: { turbo_frame: "quick_book"},
                    class: "py-3 grid grid-cols-3 items-center justify-center border text-center #{appointment_created?(slot[:id]) || slot_selected?(slot[:id]) ? 'border-emerald-500 text-emerald-500' : 'border-slate-300 text-slate-700'} cursor-pointer rounded-xl text-sm font-bold hover:border-emerald-500 hover:text-emerald-500 transition-all" do %>
                     <%if  appointment_created?(slot[:id]) %>                    
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 mx-auto">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 0 1-1.043 3.296 3.745 3.745 0 0 1-3.296 1.043A3.745 3.745 0 0 1 12 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 0 1-3.296-1.043 3.745 3.745 0 0 1-1.043-3.296A3.745 3.745 0 0 1 3 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 0 1 1.043-3.296 3.746 3.746 0 0 1 3.296-1.043A3.746 3.746 0 0 1 12 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 0 1 3.296 1.043 3.746 3.746 0 0 1 1.043 3.296A3.745 3.745 0 0 1 21 12Z" />
                        </svg>

                     <%end%>   
                      <div class="col-start-2">
                        <%= slot[:time] %>
                      </div>
                <%end%>      
              <% end %>
            <% end %>
          </div>
         
        <% if selected_slot.present? %>
          <%= button_to  appointments_path, method: :post, params: { appointment: { slot_id: selected_slot.id } }, class: "flex bg-emerald-500 text-white items-center gap-3 px-3 py-2 text-slate-500 hover:bg-emerald-600 cursor-pointer rounded-lg transition-colors", data: { turbo_method: :post } do %>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2zM10 14l2 2 4-4"></path>
          </svg>@
          
           Confirm Slot
          <% end %>           
                      
          <% else %>
            <p disabled class="flex items-center gap-3 px-3 py-2 text-slate-500 justify-center rounded-lg transition-colors">Select a Slot</p>
          <% end %>
        <% end %>
        <p class="text-center text-[10px] text-slate-400 font-medium">Sessions are 50 minutes • All times in your local timezone</p>
      </div>

      <div id="flash_messages" class="h-12"></div>

    </div>

    <%# --- Right Column (Sidebar Content) --- %>
    <div class="space-y-6">
      
      <%# Your Progress Card %>
      <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100">
        <h3 class="flex items-center gap-2 text-lg font-bold text-slate-800 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
          Your Progress
        </h3>
        
        <div class="space-y-6">
          <% [["Sessions Completed", 85], ["Goals Progress", 60], ["Mood Tracking", 72], ["Mindfulness", 45]].each do |label, value| %>
            <div>
              <div class="flex justify-between text-xs font-bold mb-2">
                <span class="text-slate-600"><%= label %></span>
                <span class="text-slate-800"><%= value %>%</span>
              </div>
              <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                <div class="bg-emerald-500 h-full rounded-full" style="width: <%= value %>%"></div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <%# Recommended Card %>
      <div class="bg-white rounded-3xl p-6 shadow-sm border border-slate-100">
        <h3 class="flex items-center gap-2 text-lg font-bold text-slate-800 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
          Recommended for You
        </h3>
        <div class="space-y-4">
          <% [
            { title: "Managing Stress in Daily Life", meta: "Article • 5 min read", icon: "file" },
            { title: "Guided Breathing Exercise", meta: "Video • 10 min", icon: "play" },
            { title: "Weekly Mood Journal", meta: "Worksheet", icon: "book" }
          ].each do |item| %>
            <div class="flex items-center gap-4 p-3 rounded-2xl hover:bg-slate-50 transition-all cursor-pointer group">
              <div class="w-10 h-10 bg-emerald-50 rounded-xl flex items-center justify-center text-emerald-500">
                <% if item[:icon] == "file" %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                <% elsif item[:icon] == "play" %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <% else %>
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                <% end %>
              </div>
              <div>
                <p class="text-sm font-bold text-slate-800"><%= item[:title] %></p>
                <p class="text-[10px] text-slate-400 font-medium"><%= item[:meta] %></p>
              </div>
              <svg xmlns="http://www.w3.org/2000/svg" class="ml-auto w-4 h-4 text-slate-300 group-hover:text-emerald-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            </div>
          <% end %>
        </div>
        <button class="w-full mt-6 text-emerald-500 text-xs font-bold hover:underline">View All Resources</button>
      </div>

    </div>
  </div>

</div>