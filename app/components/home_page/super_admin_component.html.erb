

<main class="flex-1 p-8 overflow-y-auto max-w-7xl mx-auto">
  <%= render HeaderComponent.new(title: title, subtitle: @subtitle) %>

<div class="grid grid-cols-2 md:grid-cols-2 gap-6">

  <div
    class="
      bg-emerald-500 rounded-3xl p-8 text-white flex justify-between items-center
      shadow-lg shadow-emerald-100
    "
  >
    <div class="space-y-4">
      <div class="flex items-center gap-2 opacity-90 text-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        Start Session:
      </div>
      <div>
        <h2 class="text-3xl font-bold">Sarah J</h2>
        <p class="opacity-90">10:00 AM</p>
      </div>
      <button
        class="
          bg-white text-emerald-600 px-6 py-2.5 rounded-full font-bold flex items-center
          gap-2 hover:bg-emerald-50 transition-colors
        "
      >P
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M4.5 3.5v13L16 10 4.5 3.5z"/></svg>
        Start Session
      </button>
    </div>
    <div
      class="
        w-20 h-20 bg-emerald-400 bg-opacity-50 rounded-full flex items-center
        justify-center text-3xl font-bold border-4 border-emerald-300
      "
    >
      S
    </div>
  </div>

  <div class="bg-orange-50 border border-orange-100 rounded-3xl p-8">
    <div class="flex justify-between items-center mb-6">
      <div class="flex items-center gap-2 text-slate-700 font-bold">
        <svg
          class="w-5 h-5 text-orange-500"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        ><path
            d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
          /></svg>
        Pending Notes
      </div>
      <span class="text-xs font-bold text-orange-600 flex items-center gap-1">
        <span
          class="
            w-3 h-3 border-2 border-orange-600 rounded-full flex items-center justify-center
            text-[8px]
          "
        >!</span>
        3 days overdue
      </span>
    </div>
    <div class="space-y-4">
      <% [["J. Doe", "Oct 24"], ["A. Smith", "Oct 24"]].each do |name, date| %>
        <div class="flex justify-between items-center group cursor-pointer">
          <span class="text-slate-600"><span class="text-slate-400 mr-2">-</span>
            <strong><%= name %></strong>
            <span class="text-slate-400 ml-1">(<%= date %>)</span></span>
          <div
            class="
              w-5 h-5 border-2 border-slate-300 rounded-full group-hover:border-emerald-500
              flex items-center justify-center
            "
          >
            <div
              class="
                w-2 h-2 bg-emerald-500 rounded-full opacity-0 group-hover:opacity-100
              "
            ></div>
          </div>
        </div>
      <% end %>
    </div>
  </div>

  <div class="bg-white rounded-3xl p-8 border border-slate-100 shadow-sm">
    <div class="flex items-center gap-2 text-slate-700 font-bold mb-6">
      <svg
        class="w-5 h-5 text-slate-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      ><path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Today's Schedule
    </div>
    <div class="space-y-5">
      <% todays_appointment_list.each do |appointment| %>
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-6">
            <span class="text-slate-400 text-sm w-16"><%= appointment.start_at.strftime("%I:%M %p") %></span>
            <span class="text-slate-300 mr-2">—</span>
            <span class="text-slate-700 font-medium"><%= appointment.user.user_profile.full_name %></span>
          </div>
          <div class="w-2 h-2 rounded-full <%= appointment.status == "in_progress" ? "bg-emerald-400" : "bg-slate-200" %>"></div>
        </div>
      <% end %>
      <%if todays_appointment_list.empty? %>
      <span class="flex items-center gap-2 text-slate-700 font-bold mb-6">
        No Appointments Booked yet
      </span>  
      <%end%>
    </div>
  </div>

  <div
    class="
      bg-white rounded-3xl p-8 border border-slate-100 shadow-sm flex flex-col
      justify-between
    "
  >
    <div>
      <div class="flex items-center gap-2 text-slate-700 font-bold mb-6">
        <span class="text-slate-400 text-lg">$</span>
        Financial Snapshot
      </div>
      <div class="flex justify-between items-end">
        <div>
          <p class="text-slate-400 text-xs">Weekly Revenue</p>
          <p class="text-emerald-500 text-xs font-bold flex items-center gap-1">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/></svg>
            Trending up
          </p>
        </div>
        <svg class="w-24 h-12" viewBox="0 0 100 40">
          <path
            d="M0 35 L20 30 L40 38 L60 25 L80 28 L100 15"
            fill="none"
            stroke="#10B981"
            stroke-width="3"
            stroke-linecap="round"
          />
          <circle cx="100" cy="15" r="3" fill="#10B981"/>
        </svg>
      </div>
    </div>

    <div
      class="
        mt-6 bg-orange-50 border border-orange-100 rounded-xl p-3 flex items-center
        gap-3
      "
    >
      <div
        class="
          w-5 h-5 flex items-center justify-center border border-orange-400 rounded-sm
          text-orange-600 text-[10px] font-bold
        "
      >!</div>
      <span class="text-orange-700 text-sm font-medium">Outstanding Invoices: 3</span>
    </div>
  </div>

</div>
</main>