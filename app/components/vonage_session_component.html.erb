<div class="min-h-screen py-6 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto">
    
    <div class="flex items-center justify-between mb-4 px-2">
      <div class="flex items-center gap-3">
        <div class="bg-emerald-600 p-2 rounded-lg shadow-lg shadow-emerald-200">
          <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
          </svg>
        </div>
        <h2 class="text-xl font-bold text-slate-800">Live Consultation <span class="text-slate-400 font-normal text-sm ml-2">#<%= @appointment_id %></span></h2>
      </div>
      <div class="hidden md:flex items-center gap-2 text-xs font-medium text-slate-500 bg-white px-3 py-1.5 rounded-full shadow-sm border border-slate-200">
        <span class="w-2 h-2 bg-emerald-500 rounded-full animate-pulse"></span>
        Encrypted P2P Connection
      </div>
    </div>

    <div class="bg-white p-2 sm:p-3 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.1)] border border-white relative overflow-hidden">
      
      <div data-controller="call-room" 
           data-call-room-api-key-value="<%= @app_id %>"
           data-call-room-session-id-value="<%= @session_id %>"
           data-call-room-token-value="<%= @token %>"
           data-call-room-user-name-value="<%= current_user.user_profile.full_name %>"
           data-call-room-appointment-id-value="<%= @appointment_id %>"
           data-call-room-csrf-token-value="<%= form_authenticity_token %>"
           class="w-full h-[650px] bg-slate-900 rounded-2xl overflow-hidden relative flex flex-col md:flex-row">

        <div class="flex-1 flex flex-col bg-slate-950 relative overflow-hidden group">
          
          <div class="absolute top-4 left-4 w-40 h-28 border-2 border-white/20 rounded-xl overflow-hidden z-20 bg-slate-800 shadow-2xl transition-all hover:scale-105 hover:border-emerald-500">
            <div data-call-room-target="publisher" class="w-full h-full object-cover"></div>
            <div class="absolute bottom-2 left-2 bg-black/60 backdrop-blur-md text-white px-2 py-0.5 rounded-md text-[10px] font-bold uppercase tracking-wider">
              You
            </div>
          </div>

          <div class="flex-1 flex items-center justify-center relative p-4">
            <div data-call-room-target="subscribers" class="w-full h-full flex flex-wrap gap-4 items-center justify-center"></div>
            
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-6 space-y-4 pointer-events-none">
              <div class="w-16 h-16 border-4 border-emerald-500/20 border-t-emerald-500 rounded-full animate-spin"></div>
              <p class="text-slate-400 text-sm font-medium">Waiting for participant to join...</p>
            </div>
          </div>

          <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex items-center gap-3 px-6 py-3 bg-slate-900/80 backdrop-blur-xl rounded-2xl z-30 border border-white/10 shadow-2xl transition-opacity duration-300">
            <button data-call-room-target="micBtn" data-action="click->call-room#toggleMic"
                    class="p-3 bg-slate-800 hover:bg-slate-700 text-white rounded-xl transition-all active:scale-95 border border-white/5" title="Mute Mic">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/></svg>
            </button>
            
            <button data-call-room-target="camBtn" data-action="click->call-room#toggleCam"
                    class="p-3 bg-slate-800 hover:bg-slate-700 text-white flex gap-2 rounded-xl transition-all active:scale-95 border border-white/5" title="Stop Video">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>
            </button>

            <div class="w-px h-6 bg-white/10 mx-1"></div>

            <button data-action="click->call-room#leaveSession" 
                    class="px-6 py-3 bg-red-500 hover:bg-red-600 text-white font-bold rounded-xl transition-all active:scale-95 flex items-center gap-2 shadow-lg shadow-red-500/20">
              <span class="text-sm">Leave</span>
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
            </button>
          </div>
        </div>

        <div class="w-80 flex flex-col bg-slate-900/50 backdrop-blur-md border-l border-white/5">
          <div class="p-4 border-b border-white/5 bg-slate-900/30">
            <h3 class="text-sm font-bold flex items-center gap-2">
              <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
              Session Chat
            </h3>
          </div>

          <div data-call-room-target="chatMessages" class="flex-1 overflow-y-auto p-4 space-y-4">
            <div class="text-[10px] text-center text-slate-500 uppercase tracking-widest py-4">
              Conversation Started
            </div>
          </div>

          <form data-action="submit->call-room#sendMessage" class="p-4 bg-slate-950/50">
            <div class="relative flex items-center">
              <input type="text" data-call-room-target="chatInput"
                     placeholder="Message..."
                     class="w-full pl-4 pr-12 py-3 bg-slate-800 border border-white/10 rounded-2xl text-sm focus:ring-2 focus:ring-emerald-500 focus:border-transparent transition-all placeholder-slate-500">
              <button type="submit" class="absolute right-2 p-2 bg-emerald-600 text-white rounded-xl hover:bg-emerald-500 transition-colors">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Button Active States */
  [data-call-room-target="micBtn"].muted { @apply bg-red-500/20 text-red-500 border-red-500/50; }
  [data-call-room-target="camBtn"].disabled { @apply bg-red-500/20 text-red-500 border-red-500/50; }

  /* Smooth Chat Bubbles */
  .chat-message { @apply flex flex-col max-w-[85%] animate-in fade-in slide-in-from-bottom-2; }
  .chat-message.self { @apply self-end; }
  .chat-message.other { @apply self-start; }
  
  .message-text { @apply py-2 px-3 rounded-2xl text-sm leading-relaxed; }
  .chat-message.self .message-text { @apply bg-emerald-600 text-white rounded-tr-none shadow-md shadow-emerald-900/20; }
  .chat-message.other .message-text { @apply bg-slate-800 text-slate-200 rounded-tl-none border border-white/5; }
  
  .sender-name { @apply text-[10px] font-bold text-slate-500 mb-1 ml-1 uppercase tracking-tighter; }
  
  /* Auto-hide waiting spinner when video starts */
  [data-call-room-target="subscribers"]:not(:empty) ~ div { display: none; }

  /* Custom Scrollbar */
  [data-call-room-target="chatMessages"]::-webkit-scrollbar { width: 4px; }
  [data-call-room-target="chatMessages"]::-webkit-scrollbar-thumb { @apply bg-slate-700 rounded-full; }
</style>