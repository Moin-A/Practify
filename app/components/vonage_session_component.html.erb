<script src="https://static.opentok.com/v2/js/opentok.min.js"></script>

<div 
  data-controller="call-room"
  data-call-room-api-key-value="<%= app_id %>"
  data-call-room-session-id-value="<%= call_room.vonage_session_id %>"
  data-call-room-token-value="<%= token %>"
  data-call-room-user-name-value="<%= current_user.email_address %>"
  data-call-room-appointment-id-value="<%= appointment_id %>"
  data-call-room-csrf-token-value="<%= form_authenticity_token %>"
  class="max-w-6xl mx-auto p-6"
>
  <div class="flex justify-between items-center mb-6">
    <h2 class="text-2xl font-bold">Room: <%= call_room.name %></h2>
    <span class="px-3 py-1 bg-emerald-500/20 text-emerald-400 rounded-full text-sm font-medium border border-emerald-500/30">
      <span class="animate-pulse">●</span> Live
    </span>
  </div>

  <div id="video-container">
    <div id="subscribers" data-call-room-target="subscribers"></div>
    <div id="publisher" data-call-room-target="publisher"></div>

    <div class="video-controls">
      <button 
        data-action="click->call-room#toggleMic" 
        data-call-room-target="micBtn" 
        class="control-btn"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 0 0 6-6v-1.5m-6 7.5a6 6 0 0 1-6-6v-1.5m6 7.5v3.75m-3.75 0h7.5M12 15.75a3 3 0 0 1-3-3V4.5a3 3 0 1 1 6 0v8.25a3 3 0 0 1-3 3Z" />
        </svg>    
      </button>
      <button 
        data-action="click->call-room#toggleCam" 
        data-call-room-target="camBtn" 
        class="control-btn"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M4.5 18.75h9a2.25 2.25 0 0 0 2.25-2.25v-9a2.25 2.25 0 0 0-2.25-2.25h-9A2.25 2.25 0 0 0 2.25 7.5v9a2.25 2.25 0 0 0 2.25 2.25Z" />
        </svg>
      </button>
      <button 
        data-action="click->call-room#leaveSession" 
        class="control-btn off"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">  
          <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 10.5 4.72-4.72a.75.75 0 0 1 1.28.53v11.38a.75.75 0 0 1-1.28.53l-4.72-4.72M12 18.75H4.5a2.25 2.25 0 0 1-2.25-2.25V9m12.841 9.091L16.5 19.5m-1.409-1.409c.407-.407.659-.97.659-1.591v-9a2.25 2.25 0 0 0-2.25-2.25h-9c-.621 0-1.184.252-1.591.659m12.182 12.182L2.909 5.909M1.5 4.5l1.409 1.409" />
        </svg>
      </button>
    </div>
  </div>
</div>
