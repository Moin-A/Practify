<% menu_list = current_user.super_admin? ? Practify.config.super_admin_sidebar_menu_items : Practify.config.sidebar_menu_items %>

<aside id="nav-sidebar" data-turbo-permanent data-controller="home nav"
  class="fixed top-0 left-0 z-50 flex flex-row md:flex-col w-full h-16 md:w-64 md:h-screen bg-[#F9F8F6] border-b border-slate-200 md:border-0 md:shadow-[1px_0_16px_rgba(0,0,0,0.07)]">

  <!-- ── Branding ─────────────────────────────────────────────── -->
  <div class="px-4 md:p-6 flex items-center gap-2 flex-1 md:flex-none shrink-0">
    <div class="w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center shrink-0">
      <img class="rounded-lg w-6 h-6" src="/icon.png" alt="Logo">
    </div>
    <%= link_to root_path, class: "font-bold text-xl tracking-tight" do %>
      <span>Practcify</span>
    <% end %>
  </div>

  <!-- ── Hamburger button (mobile only) ────────────────────────── -->
  <button data-action="nav#toggleMenu"
    class="md:hidden m-auto flex-shrink-0 mr-4 w-9 h-9 flex items-center justify-center rounded-lg text-slate-500 hover:bg-slate-50 transition-colors">
    <svg data-nav-target="hamburgerIcon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
    </svg>
    <svg data-nav-target="closeIcon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>

  <!-- ── Mobile dropdown ───────────────────────────────────────── -->
  <div data-nav-target="menu"
    class="md:hidden absolute top-16 left-0 right-0 bg-white border-b border-slate-200 shadow-xl z-[60] py-3
           transition-all duration-200 ease-out
           opacity-0 -translate-y-2 pointer-events-none">
    <nav class="px-3 flex flex-col gap-0.5">
      <% menu_list.each do |item| %>
        <%= link_to target_path(item[:path], user_profile),
            class: "flex items-center gap-3 px-3 py-2.5 text-slate-500 hover:bg-slate-50 rounded-lg transition-colors text-sm font-medium",
            data: { action: "nav#closeMenu", home_target: "navLink" } do %>
          <span class="shrink-0">
            <%= tag.svg(class: "w-4 h-4", **svg_attributes) { svg_inner_content(item[:icon]) } %>
          </span>
          <span><%= item[:name] %></span>
          <% if item[:name] == "Profile" %>
            <span class="ml-auto inline-block px-1.5 py-0.5 border border-black text-[8px] font-light tracking-[0.15em] leading-none rounded-sm text-black bg-transparent">
              <% if current_user.super_admin? %>SuperAdmin
              <% elsif current_user.admin? %>Admin
              <% elsif current_user.client? %>Client
              <% else %>User
              <% end %>
            </span>
          <% end %>
        <% end %>
      <% end %>
    </nav>

    <div class="border-t border-slate-100 mt-3 pt-3 px-3">
      <%= link_to session_path, method: :delete,
          class: "flex items-center gap-3 px-3 py-2.5 text-slate-500 hover:bg-slate-50 rounded-lg text-sm font-medium",
          data: { turbo_method: :delete, action: "nav#closeMenu" } do %>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4 shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
        </svg>
        <span>Logout</span>
      <% end %>
    </div>
  </div>

  <!-- ── Desktop sidebar nav (hidden on mobile) ────────────────── -->
  <nav class="hidden md:flex flex-1 flex-col items-stretch px-4 gap-1 overflow-y-auto">
    <% menu_list.each do |item| %>
      <%= link_to target_path(item[:path], user_profile),
          class: "flex items-center gap-3 px-3 py-2 text-slate-500 hover:bg-slate-50 rounded-lg transition-colors text-base",
          data: { home_target: "navLink" } do %>
        <span class="shrink-0">
          <%= tag.svg(class: "w-4 h-4", **svg_attributes) { svg_inner_content(item[:icon]) } %>
        </span>
        <span><%= item[:name] %></span>
        <% if item[:name] == "Profile" %>
          <span class="inline-block px-1.5 py-0.5 border border-black text-[9px] font-light tracking-[0.15em] leading-none rounded-sm text-black bg-transparent ml-1">
            <% if current_user.super_admin? %>SuperAdmin
            <% elsif current_user.admin? %>Admin
            <% elsif current_user.client? %>Client
            <% else %>User
            <% end %>
          </span>
        <% end %>
      <% end %>
    <% end %>
  </nav>

  <!-- ── Desktop logout ────────────────────────────────────────── -->
  <div class="hidden md:flex px-4 p-4 border-t border-slate-200 items-center">
    <%= link_to session_path, method: :delete,
        class: "flex items-center gap-3 px-3 py-2 text-slate-500 hover:bg-slate-50 rounded-lg",
        data: { turbo_method: :delete } do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
      </svg>
      <span>Logout</span>
    <% end %>
  </div>

</aside>
