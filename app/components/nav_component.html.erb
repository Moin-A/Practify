<aside id="nav-sidebar" data-turbo-permanent data-controller="home" class="fixed top-0 left-0 z-50 flex flex-row md:flex-col w-full h-16 md:w-64 md:h-screen bg-white border-r border-slate-200">
  
  <div class="px-4 md:p-6 flex items-center gap-2 shrink-0">
    <div class="w-8 h-8 bg-emerald-500 rounded-full flex items-center justify-center">
      <img class="rounded-lg w-6 h-6" src="/icon.png" alt="Logo">
    </div>
   <%= link_to root_path, class: "hidden md:block" do %>
      <span class="font-bold text-xl tracking-tight">Practcify</span>
    <% end %>
  </div>

  <nav class="flex-1 flex flex-row md:flex-col items-center md:items-stretch px-2 md:px-4 gap-1 overflow-x-auto md:overflow-x-visible no-scrollbar">
    <% menu_list = current_user.super_admin? ? Practify.config.super_admin_sidebar_menu_items : Practify.config.sidebar_menu_items %> 
    <% menu_list.each do |item| %>     
      <%= link_to target_path(item[:path], user_profile), class: "flex items-center gap-2 md:gap-3 px-3 py-2 text-slate-500 hover:bg-slate-50 rounded-lg transition-colors whitespace-nowrap text-sm md:text-base", data: { home_target: "navLink" } do %>
        
        <span class="shrink-0">
          <%= tag.svg(class: "w-3 h-3", **svg_attributes) { svg_inner_content(item[:icon]) } %>
        </span>
        
        <span class="<%= item[:name] == 'Profile' ? '' : 'hidden sm:inline' %> md:inline">
          <%= item[:name] %>
        </span>

        <% if item[:name] == "Profile" %>
          <span class="inline-block px-1.5 py-0.5 border border-black text-[8px] md:text-[9px] font-light tracking-[0.15em] leading-none rounded-sm text-black bg-transparent ml-1">
            <% if current_user.super_admin? %>
              SuperAdmin
            <% elsif current_user.admin? %>
              Admin
            <% elsif current_user.client? %>
              Client
            <% else %>
              User
            <% end %>
          </span>
        <% end %>   
      <% end %>
    <% end %>
  </nav>

  <div class="px-2 md:p-4 border-l md:border-l-0 md:border-t border-slate-200 flex items-center shrink-0"> 
    <%= link_to session_path, method: :delete, class: "flex items-center gap-3 px-3 py-2 text-slate-500 hover:bg-slate-50 rounded-lg", data: { turbo_method: :delete } do %>
     <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15M12 9l-3 3m0 0 3 3m-3-3h12.75" />
      </svg>

      <span class="hidden md:inline">Logout</span>
    <% end %>
  </div>
</aside>