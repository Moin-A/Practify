# Copy to .env.production on the server and fill in. Never commit the filled copy.

RAILS_ENV=production
# Sets the DB pool size. Solid Queue runs 5 worker threads and refuses to
# start if the pool is smaller, so do not drop this below 5.
RAILS_MAX_THREADS=5

# From config/master.key on your laptop. Without this the app will not boot.
RAILS_MASTER_KEY=

# Comma-separated Host header allowlist (config/environments/production.rb).
APP_HOSTS=practify.co.in,www.practify.co.in

# Hostnames Caddy serves and requests certificates for. Must be names whose
# DNS already resolves to this box. Keep in sync with APP_HOSTS.
SITE_ADDRESSES=practify.co.in, www.practify.co.in

# Must match POSTGRES_PASSWORD below. Host "db" is the compose service name.
DATABASE_URL=postgresql://practify:CHANGE_ME@db:5432/practify_production
POSTGRES_PASSWORD=CHANGE_ME

REDIS_URL=redis://redis:6379/1

# Mission Control jobs dashboard basic auth. If these are blank the dashboard
# ends up with nil credentials - set them.
MISSION_CONTROL_USER=admin
MISSION_CONTROL_PASSWORD=

# SES
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SMTP_ADDRESS=
SMTP_USER_NAME=
SMTP_PASSWORD=
